# --- DATABSE (PostgreSQL) ---
POSTGRES_USER=brewlite_user
POSTGRES_PASSWORD=brewlite_secret_password
POSTGRES_DB=brewlite_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://brewlite_user:brewlite_secret_password@localhost:5432/brewlite_db?schema=public"

# --- BACKEND API (NestJS) ---
PORT=4000
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
PAYMENT_SIMULATION_MODE=SUCCESS

# --- FRONTEND (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000